# Maintainer: Vanguard Arts SRL <https://vanguardarts.vip/>
pkgname=provenance-scrubber
pkgver=0.1.0
pkgrel=1
pkgdesc="Detect and strip provenance metadata (C2PA/EXIF/XMP/IPTC) from images"
arch=('any')
url="https://github.com/VanguardArts/provenance-scrubber"
license=('MIT')
depends=('python' 'python-pillow' 'python-pyside6')
optdepends=('python-flask: web UI' 'python-requests: http detector plugins')
source=("$pkgname-$pkgver.tar.gz::https://github.com/VanguardArts/provenance-scrubber/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -dm755 "$pkgdir/usr/lib/provenance-scrubber"
    cp -r scrubber "$pkgdir/usr/lib/provenance-scrubber/scrubber"
    cp cli_main.py desktop_gui.py webapp.py "$pkgdir/usr/lib/provenance-scrubber/"

    printf '#!/bin/sh\nexec python3 /usr/lib/provenance-scrubber/cli_main.py "$@"\n' > "$pkgdir/usr/bin/provenance-scrubber"
    printf '#!/bin/sh\nexec python3 /usr/lib/provenance-scrubber/desktop_gui.py "$@"\n' > "$pkgdir/usr/bin/provenance-scrubber-gui"
    chmod 755 "$pkgdir/usr/bin/provenance-scrubber" "$pkgdir/usr/bin/provenance-scrubber-gui"

    install -Dm644 packaging/provenance-scrubber.desktop \
        "$pkgdir/usr/share/applications/provenance-scrubber.desktop"
    install -Dm644 packaging/provenance-scrubber.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/provenance-scrubber.svg"
    for sz in 16 24 32 48 64 96 128 256 512; do
        install -Dm644 "packaging/icons/hicolor/${sz}x${sz}/apps/provenance-scrubber.png" \
            "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps/provenance-scrubber.png"
    done
}
